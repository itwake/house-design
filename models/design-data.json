  "bayFitouts": [
    {
      "id":"bay_a_office_vanity", "openingId":"window_a", "roomId":"room_a", "type":"office_vanity", "title":"主卧 · 一体飘窗办公梳妆台",
      "summary":"飘窗与工作台合为一整块浅木台面，不另设独立书桌；只配一把西侧朝东的带脚踏椅，笔电与活动镜共用。",
